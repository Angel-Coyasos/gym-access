APP_NAME="Gym Access System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://gym-access

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Base de Datos (PostgreSQL) ───────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=gym_db
DB_USERNAME=gym_user
DB_PASSWORD=gym_password

# ─── Colas (Redis) ────────────────────────────────────────────────────────────
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PASSWORD=gym_redis_pass
REDIS_PORT=6379

# ─── Cache ────────────────────────────────────────────────────────────────────
CACHE_STORE=redis
SESSION_DRIVER=redis

# ─── API Externa (Engagement) ─────────────────────────────────────────────────
QUOTE_API_URL=https://dummyjson.com/quotes/random
QUOTE_API_TIMEOUT=5

# ─── Outbox Worker ────────────────────────────────────────────────────────────
OUTBOX_PUBLISH_INTERVAL=5
